# Copy to `.env` next to compose.yaml and fill in what you need. `.env` is ignored by git
# and by the Docker build. Leave a line commented out to keep its default.

# --- Compose ---------------------------------------------------------------------------

# Required. Host directory with the git repositories labhq works on; mounted at /projects.
PROJECTS_DIR=
# Port on the host's 127.0.0.1 where the UI, the API and the MCP endpoint answer.
HOST_PORT=8787
# Owner of PROJECTS_DIR on the host (`id -u` and `id -g`). The container user takes these
# ids so git accepts the repositories. Never 0.
CONTAINER_UID=1000
CONTAINER_GID=1000

# --- Model access (ADR 0001) -------------------------------------------------------------

# Unset: agents use the login you complete with `docker compose exec labhq claude`.
# Set: Claude Code uses API billing with this key.
# ANTHROPIC_API_KEY=

# --- Notifications (optional) -----------------------------------------------------------

# ntfy is the default; pick a long random topic and subscribe to it in the ntfy app.
# LABHQ_NOTIFY_KIND=ntfy
# LABHQ_NOTIFY_NTFY_SERVER=https://ntfy.sh
# LABHQ_NOTIFY_NTFY_TOPIC=
# Or Telegram:
# LABHQ_NOTIFY_KIND=telegram
# LABHQ_NOTIFY_TELEGRAM_TOKEN=
# LABHQ_NOTIFY_TELEGRAM_CHAT_ID=

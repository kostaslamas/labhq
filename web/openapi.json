  "info": {
    "title": "labhq",
    "version": "0.1.0a1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/approvals": {
      "get": {
        "description": "Pending approvals first, then the settled ones, each group newest first.",
        "operationId": "approvals_list",
        "parameters": [
          {
            "description": "Only this status.",
            "in": "query",
            "name": "status",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/ApprovalStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Only this status.",
              "title": "Status"
            }
          },
          {
            "description": "Opaque; from `next_cursor`.",
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Opaque; from `next_cursor`.",
              "title": "Cursor"
            }
          },
          {
            "description": "Rows per page.",
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "minimum": 1,
                  "type": "integer"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Rows per page.",
              "title": "Limit"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Page_ApprovalOut_"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Approvals List",
        "tags": ["approvals"]
      }
    },
    "/api/approvals/{approval_id}": {
      "get": {
        "operationId": "approvals_get",
        "parameters": [
          {
            "in": "path",
            "name": "approval_id",
            "required": true,
            "schema": {
              "title": "Approval Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Approvals Get",
        "tags": ["approvals"]
      }
    },
    "/api/approvals/{approval_id}/decision": {
      "post": {
        "description": "Approve or reject. A repeated key answers with the decision it already made.",
        "operationId": "approvals_decide",
        "parameters": [
          {
            "in": "path",
            "name": "approval_id",
            "required": true,
            "schema": {
              "title": "Approval Id",
              "type": "integer"
            }
          },
          {
            "description": "One per user intent; a retry reuses it.",
            "in": "header",
            "name": "idempotency-key",
            "required": true,
            "schema": {
              "description": "One per user intent; a retry reuses it.",
              "maxLength": 128,
              "minLength": 1,
              "title": "Idempotency-Key",
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DecisionBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApprovalOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Approvals Decide",
        "tags": ["approvals"]
      }
    },
    "/api/approvals/{approval_id}/step-up": {
      "post": {
        "description": "A passkey challenge bound to this approval and this session.",
        "operationId": "approvals_step_up",
        "parameters": [
          {
            "in": "path",
            "name": "approval_id",
            "required": true,
            "schema": {
              "title": "Approval Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Approvals Step Up",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Approvals Step Up",
        "tags": ["approvals"]
      }
    },
    "/api/auth/credentials": {
      "get": {
        "operationId": "auth_credentials_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Credential"
                  },
                  "title": "Response Auth Credentials List",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Credentials List",
        "tags": ["auth"]
      }
    },
    "/api/auth/credentials/{credential_id}": {
      "delete": {
        "operationId": "auth_credentials_revoke",
        "parameters": [
          {
            "in": "path",
            "name": "credential_id",
            "required": true,
            "schema": {

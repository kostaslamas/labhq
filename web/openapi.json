{
  "components": {
    "schemas": {
      "AgentStatus": {
        "enum": ["pending_approval", "active", "paused", "retired"],
        "title": "AgentStatus",
        "type": "string"
      },
      "ApprovalStatus": {
        "enum": ["pending", "approved", "rejected", "executed", "execution_failed", "cancelled"],
        "title": "ApprovalStatus",
        "type": "string"
      },
      "AssertionBody": {
        "properties": {
          "credential": {
            "additionalProperties": true,
            "title": "Credential",
            "type": "object"
          }
        },
        "required": ["credential"],
        "title": "AssertionBody",
        "type": "object"
      },
      "AuthStatus": {
        "properties": {
          "authenticated": {
            "title": "Authenticated",
            "type": "boolean"
          },
          "enrolled": {
            "title": "Enrolled",
            "type": "boolean"
          }
        },
        "required": ["authenticated", "enrolled"],
        "title": "AuthStatus",
        "type": "object"
      },
      "CallRequestStatus": {
        "enum": ["pending", "answered", "failed", "expired"],
        "title": "CallRequestStatus",
        "type": "string"
      },
      "CallStatus": {
        "enum": ["open", "closed"],
        "title": "CallStatus",
        "type": "string"
      },
      "Credential": {
        "description": "What the UI may know about a passkey. The public key stays on the server.",
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "integer"
          },
          "last_used_at": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Used At"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "revoked": {
            "title": "Revoked",
            "type": "boolean"
          },
          "rp_id": {
            "title": "Rp Id",
            "type": "string"
          },
          "transports": {
            "items": {
              "type": "string"
            },
            "title": "Transports",
            "type": "array"
          }
        },
        "required": ["id", "name", "rp_id", "transports", "created_at", "last_used_at", "revoked"],
        "title": "Credential",
        "type": "object"
      },
      "EnrollOptionsBody": {
        "properties": {
          "token": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": ["token"],
        "title": "EnrollOptionsBody",
        "type": "object"
      },
      "EnrollVerifyBody": {
        "properties": {
          "credential": {
            "additionalProperties": true,
            "title": "Credential",
            "type": "object"
          },
          "name": {
            "default": "Passkey",
            "maxLength": 200,
            "title": "Name",
            "type": "string"
          },
          "token": {
            "maxLength": 200,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": ["token", "credential"],
        "title": "EnrollVerifyBody",
        "type": "object"
      },
      "EnrollmentLink": {
        "properties": {
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "qr": {
            "title": "Qr",
            "type": "string"
          },
          "url": {
            "title": "Url",
            "type": "string"
          }
        },
        "required": ["url", "expires_at", "qr"],
        "title": "EnrollmentLink",
        "type": "object"
      },
      "EnrollmentLinkBody": {
        "properties": {
          "target": {
            "default": "public",
            "enum": ["public", "here"],
            "title": "Target",
            "type": "string"
          }
        },
        "title": "EnrollmentLinkBody",
        "type": "object"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          }
        },
        "required": ["code", "message"],
        "title": "ErrorBody",
        "type": "object"
      },
      "ErrorEnvelope": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "required": ["error"],
        "title": "ErrorEnvelope",
        "type": "object"
      },
      "Health": {
        "properties": {
          "version": {
            "title": "Version",
            "type": "string"
          }
        },
        "required": ["version"],
        "title": "Health",
        "type": "object"
      },
      "HostStatus": {
        "enum": ["unknown", "up", "degraded", "down"],
        "title": "HostStatus",
        "type": "string"
      },
      "IncidentStatus": {
        "enum": ["open", "resolved"],
        "title": "IncidentStatus",
        "type": "string"
      },
      "MeetingStatus": {
        "enum": ["requested", "running", "ended", "failed", "cancelled"],
        "title": "MeetingStatus",
        "type": "string"
      },
      "NotificationStatus": {
        "enum": ["pending", "sent", "failed"],
        "title": "NotificationStatus",
        "type": "string"
      },
      "ProjectStatus": {
        "enum": ["active", "paused", "archived"],
        "title": "ProjectStatus",
        "type": "string"
      },
      "QuestionStatus": {
        "enum": ["pending", "answered"],
        "title": "QuestionStatus",
        "type": "string"
      },
      "RunStatus": {
        "enum": ["queued", "running", "succeeded", "failed", "interrupted", "timed_out"],
        "title": "RunStatus",
        "type": "string"
      },
      "StepUpBody": {
        "properties": {
          "purpose": {
            "maxLength": 64,
            "title": "Purpose",
            "type": "string"
          }
        },
        "required": ["purpose"],
        "title": "StepUpBody",
        "type": "object"
      },
      "TaskStatus": {
        "enum": ["backlog", "todo", "in_progress", "in_review", "blocked", "done", "cancelled"],
        "title": "TaskStatus",
        "type": "string"
      },
      "Vocabulary": {
        "description": "The status values the backend may return, by enum.",
        "properties": {
          "agent_status": {
            "description": "Every value of `AgentStatus`.",
            "items": {
              "$ref": "#/components/schemas/AgentStatus"
            },
            "title": "Agent Status",
            "type": "array"
          },
          "approval_status": {
            "description": "Every value of `ApprovalStatus`.",
            "items": {
              "$ref": "#/components/schemas/ApprovalStatus"
            },
            "title": "Approval Status",
            "type": "array"
          },
          "call_request_status": {
            "description": "Every value of `CallRequestStatus`.",
            "items": {
              "$ref": "#/components/schemas/CallRequestStatus"
            },
            "title": "Call Request Status",
            "type": "array"
          },
          "call_status": {
            "description": "Every value of `CallStatus`.",
            "items": {
              "$ref": "#/components/schemas/CallStatus"
            },
            "title": "Call Status",
            "type": "array"
          },
          "host_status": {
            "description": "Every value of `HostStatus`.",
            "items": {
              "$ref": "#/components/schemas/HostStatus"
            },
            "title": "Host Status",
            "type": "array"
          },
          "incident_status": {
            "description": "Every value of `IncidentStatus`.",
            "items": {
              "$ref": "#/components/schemas/IncidentStatus"
            },
            "title": "Incident Status",
            "type": "array"
          },
          "meeting_status": {
            "description": "Every value of `MeetingStatus`.",
            "items": {
              "$ref": "#/components/schemas/MeetingStatus"
            },
            "title": "Meeting Status",
            "type": "array"
          },
          "notification_status": {
            "description": "Every value of `NotificationStatus`.",
            "items": {
              "$ref": "#/components/schemas/NotificationStatus"
            },
            "title": "Notification Status",
            "type": "array"
          },
          "project_status": {
            "description": "Every value of `ProjectStatus`.",
            "items": {
              "$ref": "#/components/schemas/ProjectStatus"
            },
            "title": "Project Status",
            "type": "array"
          },
          "question_status": {
            "description": "Every value of `QuestionStatus`.",
            "items": {
              "$ref": "#/components/schemas/QuestionStatus"
            },
            "title": "Question Status",
            "type": "array"
          },
          "run_status": {
            "description": "Every value of `RunStatus`.",
            "items": {
              "$ref": "#/components/schemas/RunStatus"
            },
            "title": "Run Status",
            "type": "array"
          },
          "task_status": {
            "description": "Every value of `TaskStatus`.",
            "items": {
              "$ref": "#/components/schemas/TaskStatus"
            },
            "title": "Task Status",
            "type": "array"
          },
          "wakeup_status": {
            "description": "Every value of `WakeupStatus`.",
            "items": {
              "$ref": "#/components/schemas/WakeupStatus"
            },
            "title": "Wakeup Status",
            "type": "array"
          }
        },
        "required": [
          "agent_status",
          "approval_status",
          "call_request_status",
          "call_status",
          "host_status",
          "incident_status",
          "meeting_status",
          "notification_status",
          "project_status",
          "question_status",
          "run_status",
          "task_status",
          "wakeup_status"
        ],
        "title": "Vocabulary",
        "type": "object"
      },
      "WakeupStatus": {
        "enum": ["pending", "dispatched", "refused", "cancelled"],
        "title": "WakeupStatus",
        "type": "string"
      }
    }
  },
  "info": {
    "title": "labhq",
    "version": "0.1.0a1"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/auth/credentials": {
      "get": {
        "operationId": "auth_credentials_list",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Credential"
                  },
                  "title": "Response Auth Credentials List",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Credentials List",
        "tags": ["auth"]
      }
    },
    "/api/auth/credentials/{credential_id}": {
      "delete": {
        "operationId": "auth_credentials_revoke",
        "parameters": [
          {
            "in": "path",
            "name": "credential_id",
            "required": true,
            "schema": {
              "title": "Credential Id",
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Credential"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Credentials Revoke",
        "tags": ["auth"]
      }
    },
    "/api/auth/enroll/options": {
      "post": {
        "operationId": "auth_enroll_options",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollOptionsBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Auth Enroll Options",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Enroll Options",
        "tags": ["auth"]
      }
    },
    "/api/auth/enroll/verify": {
      "post": {
        "operationId": "auth_enroll_verify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollVerifyBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Credential"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Enroll Verify",
        "tags": ["auth"]
      }
    },
    "/api/auth/enrollment-links": {
      "post": {
        "description": "A one-time link for another passkey, with a QR code to open it on a phone.",
        "operationId": "auth_enrollment_links_create",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EnrollmentLinkBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EnrollmentLink"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Enrollment Links Create",
        "tags": ["auth"]
      }
    },
    "/api/auth/login/options": {
      "post": {
        "operationId": "auth_login_options",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Auth Login Options",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Login Options",
        "tags": ["auth"]
      }
    },
    "/api/auth/login/verify": {
      "post": {
        "operationId": "auth_login_verify",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AssertionBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Login Verify",
        "tags": ["auth"]
      }
    },
    "/api/auth/logout": {
      "post": {
        "operationId": "auth_logout",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Logout",
        "tags": ["auth"]
      }
    },
    "/api/auth/status": {
      "get": {
        "description": "Whether this browser is signed in, without a 401 for the login page to special-case.",
        "operationId": "auth_status",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthStatus"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Status",
        "tags": ["auth"]
      }
    },
    "/api/auth/step-up/options": {
      "post": {
        "description": "Challenge for one purpose, such as `approval:42`; the approval endpoint checks the answer.",
        "operationId": "auth_step_up_options",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StepUpBody"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "title": "Response Auth Step Up Options",
                  "type": "object"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Auth Step Up Options",
        "tags": ["auth"]
      }
    },
    "/api/health": {
      "get": {
        "description": "Answer without a session, so a probe or the UI can tell the server is up.",
        "operationId": "health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Health Get",
        "tags": ["health"]
      }
    },
    "/api/vocabulary": {
      "get": {
        "description": "The backend's status values; the UI maps each one onto its own states.",
        "operationId": "vocabulary_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Vocabulary"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorEnvelope"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Vocabulary Get",
        "tags": ["vocabulary"]
      }
    }
  }
}
